# Copy to .env.local. Without these, the app runs in demo-only mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, public: Google OAuth web client ID. Enables Google's own sign-in button, so the consent
# screen names this site instead of the Supabase project. Without it, sign-in uses the redirect flow.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional, server-only: enables AI Autofill (OpenAI). Without it, a deterministic parser is used.
OPENAI_API_KEY=
# Optional: which OpenAI model autofill uses (default gpt-5-mini).
OPENAI_MODEL=

# Optional, server-only: Street View photos of each place (Google Street View Static API).
# Without it, places show a "No street photo" tile.
GOOGLE_MAPS_API_KEY=
